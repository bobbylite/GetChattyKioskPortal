@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
    </Authorized>
    <NotAuthorized>
    <!-- Logged-out message: centered card with subtle shadow -->
        <section class="vh-100 d-flex align-items-center justify-content-center bg-light">
        <div class="container">
            <div class="row justify-content-center">
            <div class="col-sm-10 col-md-8 col-lg-6">
                <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <!-- subtle icon -->
                    <div class="mb-3">
                    <svg class="bi" width="48" height="48" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                        <path fill-rule="evenodd" d="M14 14s-1-4-6-4-6 4-6 4 1 0 6 0 6 0 6 0z"/>
                    </svg>
                    </div>

                    <h2 class="h4 mb-2">You're signed out</h2>
                    <p class="text-muted mb-4">
                    For your security, your session has ended. Sign back in to continue where you left off.
                    </p>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                    <a href="/signin" class="btn btn-primary btn-lg px-4">
                        Sign In
                    </a>
                    <a href="/" class="btn btn-outline-secondary btn-lg px-4">
                        Browse as guest
                    </a>
                    </div>

                    <small class="d-block text-muted mt-3">Need help? <a href="/support">Contact support</a></small>
                </div>
                </div>

                <!-- optional micro-footer -->
                <div class="text-center mt-3 text-muted small">
                © <span id="year"></span> YourCompany — <a href="/privacy">Privacy</a>
                </div>
            </div>
            </div>
        </div>
        </section>

        <script>
        // fill year
        document.getElementById('year').textContent = new Date().getFullYear();
        </script>

    </NotAuthorized>
</AuthorizeView>

@code{
    public void BeginLogOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}
