@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="text-success text-center mt-4">
            <h3>Welcome, @context.User.Identity?.Name!</h3>
            <button class="btn btn-outline-danger mt-3" @onclick="BeginLogOut">Log out</button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <img src="images/GetChattyLogo.png" alt="Logo" style="max-height:80px;" class="mb-3" />
            <h3 class="text-danger">Login Failed</h3>
            <p class="text-muted mt-3">
                We couldn’t sign you in. This might happen if:
            </p>
            <ul class="list-unstyled">
                <li>• You don’t have access to this application.</li>
                <li>• Your account is missing required group membership.</li>
                <li>• Your session expired.</li>
            </ul>
            <p class="mt-3">
                Please contact your administrator or <a href="/authentication/login" class="text-primary fw-semibold">try again</a>.
            </p>
        </div>
    </NotAuthorized>
</AuthorizeView>


@code{
    public void BeginLogOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}
