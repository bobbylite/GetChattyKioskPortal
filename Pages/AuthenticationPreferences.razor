@page "/AuthenticationPreferences"

@implements IAsyncDisposable
@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication 
@using System.Text.Json

@inject IOptionsSnapshot<RemoteAuthenticationOptions<OidcProviderOptions>> OpenIdConnectOptions  
@inject IJSRuntime JsRuntime
@inject ILogger<AuthenticationPreferences> _logger
@inject NavigationManager NavigationManager

<PageTitle>Password Preferences</PageTitle>

<div id="widget" class="skWidget">
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary mt-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Authorizing, please wait...</p>
        </div>
    </div>
</div>

@code {
    private ClaimsPrincipal? _user;
    private IJSObjectReference? _jsModule;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }
    private DotNetObjectReference<AuthenticationPreferences>? objRef;

    /// <summary>
    /// Initializes the component asynchronously. It checks if the authentication state is not null,
    /// retrieves the current user from the authentication state, and creates a DotNetObjectReference
    /// to this component for JavaScript interop.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null)
        {
            return;
        }

        var authState = await AuthState;
        _user = authState.User;
        objRef = DotNetObjectReference.Create(this);
    }

    /// <summary>
    /// Executes after the component has rendered. On the first render, it imports a JavaScript module
    /// associated with this component, retrieves user claims, and initializes JavaScript functionality
    /// by invoking methods in the imported module with necessary parameters.
    /// </summary>
    /// <param name="firstRender">Indicates whether this is the first time the component is being rendered.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/AuthenticationPreferences.razor.js");
            
            var oidcOptions = OpenIdConnectOptions.Value.ProviderOptions;
            ArgumentNullException.ThrowIfNull(oidcOptions);

        }
    }

    /// <summary>
    /// Asynchronously disposes of the resources.
    /// </summary>
    /// <returns>A task that represents the asynchronous dispose operation.</returns>
    public async ValueTask DisposeAsync()
    {
        if (_jsModule is null)
        {
            return;
        }

        await _jsModule.InvokeVoidAsync("dispose");
    }
}